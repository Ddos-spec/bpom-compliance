# Copy this file as .env. Never commit .env.
PORT=4173
SERVICE_FEE_IDR=25000
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
TERA_ADMIN_KEY=
# Use a real HTTPS origin for email recovery, e.g. https://tera.example.com
TERA_PUBLIC_URL=
RESEND_API_KEY=
TERA_EMAIL_FROM=
# Used by Docker Compose / Caddy; DNS A/AAAA must point to the deployment server.
TERA_DOMAIN=
# Without Docker, specify a writable persistent location; leave blank for ./data.
TERA_DATA_DIR=
