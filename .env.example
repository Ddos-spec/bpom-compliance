# Copy to .env. Do not commit .env or put any keys in frontend.
PORT=4173
# Example pilot price, change to your actual approved service fee.
SERVICE_FEE_IDR=25000
# Midtrans sandbox or production Server Key (never Client Key).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Random secret 24+ characters (staff API disabled if blank).
TERA_ADMIN_KEY=
# Must be a persistent writable disk in production, not ephemeral serverless filesystem.
TERA_DATA_DIR=
